NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (REST + websockets).
CORS_ORIGIN=http://localhost:5173
CLINIC_TIMEZONE=Asia/Kolkata

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# Administrator account created at startup.
SEED_ADMIN_EMAIL=admin@drbhushan.clinic
SEED_ADMIN_PASSWORD=ChangeMe123!

# Allow self-service sign-up via POST /api/auth/register (new users get the Reception role).
ALLOW_REGISTRATION=false

# One-click "Super Admin / Doctor / Receptionist" logins on the sign-in page.
# Defaults to true outside production; keep it false on any real deployment.
DEMO_LOGINS=true
